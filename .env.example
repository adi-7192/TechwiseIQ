# Contact form delivery (Resend) — form returns a visible error if unset
RESEND_API_KEY=

# Privacy-friendly analytics — script only loads when set (e.g. techwiseiq.com)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
